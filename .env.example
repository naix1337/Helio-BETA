# ════════════════════════════════════════════════════════════
# Helio — Environment Configuration
# ════════════════════════════════════════════════════════════
# Copy to .env and adjust. All values are optional unless noted.
# ════════════════════════════════════════════════════════════

# ── Server ──
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
TZ=Europe/Berlin

# ── Database (SQLite) ──
DB_PATH=./helio.db

# ── Authentication ──
# Recommended in production: openssl rand -hex 64
# If unset, a secret is generated once and stored next to the DB (.helio-secret)
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Reverse proxy / CORS ──
# Set to 1 when running behind exactly one reverse proxy (nginx, traefik, NPM)
TRUST_PROXY=
# Only needed if the frontend is served from a different origin
CORS_ORIGIN=*
API_RATE_LIMIT=600

# ── Data Retention ──
RETENTION_RAW_DAYS=7

# ── Notifications ──
NTFY_DEFAULT_SERVER=https://ntfy.sh
# Allow webhook/ntfy targets in private networks (self-hosted ntfy, Home Assistant…)
NOTIFICATION_ALLOW_PRIVATE=false

# ── Backups (SQLite online backup, daily) ──
BACKUP_ENABLED=false
# BACKUP_DIR=/app/data/backups
BACKUP_RETENTION_DAYS=30
