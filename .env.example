# ════════════════════════════════════════════════════════════
# Helio — Environment Configuration
# ════════════════════════════════════════════════════════════
# Copy this file to .env and adjust values for your setup.
# For production, generate a strong JWT_SECRET:
#   openssl rand -hex 64
# ════════════════════════════════════════════════════════════

# ── Server ──
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# ── Database (SQLite) ──
DB_PATH=./helio.db

# ── Authentication ──
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── CORS ──
# In production, set to your frontend domain: https://helio.example.com
CORS_ORIGIN=*

# ── Data Retention ──
RETENTION_RAW_DAYS=7

# ── Notifications ──
NTFY_DEFAULT_SERVER=https://ntfy.sh

# ── Backups ──
BACKUP_ENABLED=true
BACKUP_DIR=/app/data/backups
BACKUP_RETENTION_DAYS=30
